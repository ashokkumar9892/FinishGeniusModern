<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for Finish Genius (ASP.NET Core Module V2, in-process hosting).
  Requires the ".NET 10 Hosting Bundle" on the server. `dotnet publish` keeps these settings.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\FinishGenius.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering>
          <!-- 250 MB: work-instruction videos and document uploads -->
          <requestLimits maxAllowedContentLength="262144000" />
        </requestFiltering>
      </security>
      <staticContent>
        <remove fileExtension=".mp4" />
        <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
        <remove fileExtension=".webmanifest" />
        <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
